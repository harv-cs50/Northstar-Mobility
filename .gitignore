# Keep local PostgreSQL environment files and secrets out of Git.
.env
.env.*
!.env.example

# Database backups can contain customer data and password hashes.
*.dump
*.backup
*.sql.gz

# Generated builds and frontend dependencies
backend/build*/
frontend/node_modules/
frontend/dist/
*.log

# All backend build directories and compiled files
backend/build*/
*.exe
*.dll
*.o
*.obj

# Node.js backend
backend-node/node_modules/
backend-node/coverage/
backend-node/*.log