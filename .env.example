# Copy these placeholders into the terminal environment used to start VRMS.
# The application does not load .env files automatically.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=vrms_demo
PGUSER=
PGPASSWORD=

VRMS_API_HOST=127.0.0.1
VRMS_API_PORT=8080
# Configure one exact frontend origin in production; use HTTPS.
VRMS_ALLOWED_ORIGIN=http://localhost:5173
VRMS_ADMIN_BOOTSTRAP_TOKEN=

# Optional percentage; defaults to 0. Configure only for your project/tax rules.
VRMS_INVOICE_TAX_PERCENT=0

# SMTP settings. Use STARTTLS on port 587 or implicit TLS on port 465.
VRMS_SMTP_HOST=smtp.example.com
VRMS_SMTP_PORT=587
VRMS_SMTP_USERNAME=your-smtp-username
VRMS_SMTP_PASSWORD=replace-with-smtp-secret
VRMS_SMTP_FROM_EMAIL=invoices@example.com
VRMS_SMTP_FROM_NAME=Northstar Mobility
VRMS_SMTP_SECURITY=starttls
VRMS_SMTP_TIMEOUT_SECONDS=20

# Use the complete Google AI Studio key unchanged (including an AQ. prefix, if present).
# Gemini credentials are backend-only; never copy either value to a VITE_* variable.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
