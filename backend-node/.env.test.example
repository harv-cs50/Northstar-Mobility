# Dedicated credentials for the local disposable integration database only.
# The host is fixed to 127.0.0.1 and database name to vrms_node_test in the harness.
# Keep the real values in process environment variables or an ignored .env.test file.
VRMS_TEST_PGUSER=your-local-postgres-user
VRMS_TEST_PGPASSWORD=replace-with-local-test-password
