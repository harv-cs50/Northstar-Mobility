# Copy to .env for local development. Replace placeholders in your own environment.
# Do not commit .env or put credentials in frontend VITE_* variables.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=vrms_local
PGUSER=your-postgres-user
PGPASSWORD=replace-with-local-secret

# One exact frontend origin; no wildcard. Use the deployed HTTPS origin in production.
ALLOWED_ORIGIN=http://localhost:5173

# Required only for one-time initial administrator provisioning.
VRMS_ADMIN_BOOTSTRAP_TOKEN=

# Optional invoice tax percentage (0–100); defaults to 0, matching the C++ backend.
VRMS_INVOICE_TAX_PERCENT=0

# Optional AI support. Keep these values on the API server only; never use VITE_* names.
# Open-ended questions require both settings. Database-backed answers do not.
GEMINI_API_KEY=replace-with-server-side-gemini-key
GEMINI_MODEL=gemini-2.5-flash

# Resend configuration for invoice delivery. Keep the API key on the backend.
RESEND_API_KEY=replace-with-server-side-resend-api-key
RESEND_FROM_EMAIL=invoices@example.com
RESEND_FROM_NAME=Northstar Mobility

# The API listens on this port. Defaults to 8080 if omitted.
PORT=8080
